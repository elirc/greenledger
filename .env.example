# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/greenledger_dev
# Used only by the test runner (orchestrated; never by the app)
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/greenledger_test

# --- Auth ---
BETTER_AUTH_SECRET=change-me-32-chars-minimum-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 1 = OTP is always 123456, no SMS sent. The app REFUSES to start in production with this on.
AUTH_MOCK=1
# Local testing ONLY: skip the sign-in screen and auto-login as a seeded demo
# account ("1" = owner@demo.farm, or set another demo email). Only works for
# the @demo.farm seed accounts. Leave unset in any real deployment.
#AUTH_AUTOLOGIN=1

# --- Adapters (mock|real driver selection) ---
ADAPTER_SMS=mock            # mock | termii
ADAPTER_EMAIL=mock          # mock | resend
ADAPTER_PAYMENTS=mock       # mock | paystack
ADAPTER_STORAGE=local       # local | s3

# Termii (real SMS driver)
TERMII_API_KEY=
TERMII_SENDER_ID=GreenLedger
TERMII_CHANNEL=dnd

# Resend (real email driver)
RESEND_API_KEY=
EMAIL_FROM=no-reply@greenledger.example

# Paystack (real payments driver)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# S3-compatible storage (real storage driver)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Local-disk storage driver
STORAGE_DIR=./storage

# --- Worker ---
PGBOSS_SCHEMA=pgboss
